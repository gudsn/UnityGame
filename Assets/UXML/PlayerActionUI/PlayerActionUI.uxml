<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UXML/PlayerActionUI/PlayerActionUI.uss?fileID=7433441132597879392&amp;guid=bcb1c2fba5996f74aa13d0688fda049a&amp;type=3#PlayerActionUI"/>
    <ui:VisualElement name="PlayerActionRoot" style="flex-grow: 1; flex-direction: row; align-items: flex-end; justify-content: flex-start; width: 100%; height: 100%;">
        <ui:VisualElement name="ActionsContainer" style="flex-grow: 1; flex-direction: row; height: 100px; position: absolute; top: auto; left: 20px; bottom: 20px; right: auto;">
            <ui:Button text="Attack" name="Attack_btn" class="grow-button" style="background-color: rgb(128, 128, 128); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(123, 47, 47); border-right-color: rgb(123, 47, 47); border-top-color: rgb(123, 47, 47); border-bottom-color: rgb(123, 47, 47); -unity-font-style: bold; -unity-text-auto-size: none; width: 80px;"/>
            <ui:Button text="Move" name="Move_btn" class="grow-button" style="background-color: rgb(128, 128, 128); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(18, 89, 36); border-right-color: rgb(18, 89, 36); border-top-color: rgb(18, 89, 36); border-bottom-color: rgb(18, 89, 36); width: 80px; -unity-font-style: bold; text-shadow: 0 0 0 rgba(0, 0, 0, 0);"/>
            <ui:Button text="Orb" name="Orb_btn" class="grow-button" style="background-color: rgb(128, 128, 128); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(65, 31, 82); border-right-color: rgb(65, 31, 82); border-top-color: rgb(65, 31, 82); border-bottom-color: rgb(65, 31, 82); width: 80px; -unity-font-style: bold;"/>
            <ui:Button text="Tool" name="Tools_btn" parse-escape-sequences="true" class="grow-button" style="background-color: rgb(128, 128, 128); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(43, 35, 35); border-right-color: rgb(43, 35, 35); border-top-color: rgb(43, 35, 35); border-bottom-color: rgb(43, 35, 35); width: 79px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="EmptyContainer" style="flex-grow: 1;"/>
        <ui:VisualElement name="NextContainer" style="flex-grow: 1; height: 100px; align-self: flex-end; align-items: flex-end; justify-content: center;">
            <ui:Button text="Next" emoji-fallback-support="false" name="Next_btn" class="grow-button" style="background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Sprites/Turn_End.png?fileID=2800000&amp;guid=712af41df96c8e041a4510cd7aa3c8a0&amp;type=3#Turn_End&quot;); width: 150px; height: 150px; -unity-font-style: bold; position: absolute; right: 20px; bottom: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
