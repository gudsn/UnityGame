/* 화면 중앙 상단 고정 컨테이너 */
.round-container {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: flex-start;
}

/* 반투명 배경을 조금 더 진하게 처리한 배지 스타일 */
.round-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5); /* 알파값 0.5로 진함 정도를 상향 */
    border-width: 0;
    border-radius: 8px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
}

/* 'ROUND' 타이틀 텍스트 */
.round-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: #000000;
    margin-right: 16px;
    letter-spacing: 2px;
}

/* 라운드 수치 텍스트 */
.round-number {
    font-size: 54px;
    -unity-font-style: bold;
    color: #000000;
}