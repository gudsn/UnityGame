/* 타임라인 바 전체 래퍼 */
.timeline-container {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    width: 92%;
    height: 155px;
    justify-content: center;
    align-items: center;
    picking-mode: ignore;
}

.box-chain-container {
    picking-mode: ignore;
}

/* 수평 스크롤 뷰 */
.timeline-scroll-view {
    width: 100%;
    height: 100%;
    picking-mode: ignore;
}

.timeline-scroll-view .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
    picking-mode: ignore;
}

.timeline-rail {
    flex-direction: row;
    align-items: flex-end;
    picking-mode: ignore;
}

/* 틱 컬럼 */
.tick-column {
    align-items: center;
    min-width: 70px;
    picking-mode: ignore;
}

.tick-box-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 70px;
    height: 70px;
    picking-mode: ignore;
}

/* 타임라인 틱 사이 이음선 */
.tick-connector {
    width: 24px;
    height: 4px;
    background-color: #4A3B32;
    align-self: flex-start;
    margin-top: 33px;
    margin-left: -4px;
    margin-right: -4px;
    picking-mode: ignore;
}

/* 마름모 노드 크기 */
.empty-node {
    width: 66px;
    height: 66px;
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: ignore;
    opacity: 0.85;
}

/* 행동 박스 크기 */
.box-item {
    width: 68px;
    height: 68px;
    margin-left: 0;
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: position;
    transition-property: scale;
    transition-duration: 0.15s;
}

.box-item:hover {
    scale: 1.1;
}

/* 연파랑(#3B5998) 브래킷 선 (└──────┘) */
.tick-line {
    width: 100%;
    min-width: 58px;
    height: 6px;
    background-color: transparent;
    
    /* 하단 가로 밑줄 */
    border-bottom-width: 2px;
    border-bottom-color: #3B5998;
    
    /* 좌측 위로 꺾인 선 */
    border-left-width: 2px;
    border-left-color: #3B5998;
    border-bottom-left-radius: 2px;
    
    /* 우측 위로 꺾인 선 */
    border-right-width: 2px;
    border-right-color: #3B5998;
    border-bottom-right-radius: 2px;

    /* 상단 테두리 제거 */
    border-top-width: 0;

    margin-top: 4px;
    picking-mode: ignore;
}

/* 💡 [수정] 폰트 크기 확대 (16px -> 20px) 및 간격 조정 */
.tick-label {
    margin-top: 5px;
    font-size: 20px;
    color: #3B5998;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: initial;
    -unity-font: url("project://database/Assets/Fonts/온글잎 박다현체.ttf");
    picking-mode: ignore;
}

.box-item.is-executing {
    scale: 1.35;
    transition-property: scale;
    transition-duration: 0.25s;
}

/* 드래그 체인 프리뷰 */
.chain-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    picking-mode: ignore;
}

.box-divider {
    width: 24px;
    height: 4px;
    background-color: #4A3B32;
    margin-left: -4px;
    margin-right: -4px;
    picking-mode: ignore;
}