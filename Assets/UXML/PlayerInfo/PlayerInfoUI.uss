/* UI 전체 컨테이너 */
.player-info-container {
    -unity-font-definition: url("project://database/Assets/Fonts/온글잎 박다현체.ttf");
    position: absolute;
    top: 250px;
    left: 20px;
    flex-direction: row;
    align-items: flex-start;
    padding: 0;
    margin: 0;
}

/* 초상화 영역 */
.portrait-frame {
    width: 160px;
    height: 180px;
    min-width: 160px;
    min-height: 180px;
    margin-right: 12px;
    padding: 0;
    flex-shrink: 0;
}

.portrait-image {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-background-scale-mode: stretch-to-fill; 
}

/* 우측 정보 컬럼 */
.info-right-column {
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    height: 180px;
    padding: 0;
    margin: 0;
}

/* 게이지 레이아웃 */
.gauge-container {
    flex-direction: column;
    margin-bottom: 2px;
}

.gauge-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    height: 18px; /* 높이 약간 확보 */
}

.mp-group-indent {
    margin-left: 10px;
}

/* =========================================================
   💡 게이지 바 핵심 수정 구역
   ========================================================= */

/* 1. 테두리 배경 요소 (바.png) */
.custom-bar-bg {
    width: 130px;
    height: 16px;
    min-width: 130px;
    min-height: 16px;
    margin: 0;
    
    /* 💡 핵심: Fill이 테두리를 가리지 않도록 안쪽 여백(패딩) 부여 */
    padding: 2px; 
    
    position: relative;
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
}

.custom-bar-bg-mp {
    width: 115px;
    min-width: 115px;
}

/* 2. 게이지 내용물 Fill 요소 (체력바/마나바.png) */
.custom-bar-fill {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* 스텟 레이아웃 */
.stat-section {
    flex-direction: column;
    margin-top: 0;
    padding: 0;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
    height: 24px;
}

/* 폰트 스타일 모음 */
.unity-label, Label {
    -unity-font-definition: url("project://database/Assets/Fonts/온글잎 박다현체.ttf");
    color: #1a2b58;
}

.gauge-text {
    font-size: 14px;
    color: #1a2b58;
    margin-left: 6px;
    -unity-font-style: bold;
}

.stat-label {
    width: 45px;
    font-size: 20px;
    color: #1a2b58;
    -unity-font-style: bold;
}

.stat-value {
    font-size: 20px;
    color: #1a2b58;
    -unity-font-style: bold;
    margin-left: 8px;
}